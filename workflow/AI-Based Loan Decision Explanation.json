    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a credit risk analyst.\n\nLoan Details:\n- Grade: {{$json.grade}}\n- Interest Rate: {{$json.interest_rate}}\n- DTI: {{$json.dti}}\n- Income: {{ $json.income_cat }}\n- Employment Length:{{ $json.emp_length_int }}\n\nUser Question:\n{{$json.question}}\n\nInstructions:\n- Answer ONLY the question\n- Keep it short (2–3 lines)\n- Use simple business language\n- Compare briefly with good loans if relevant\n\nOutput ONLY the explanation text.",
        "batching": {}
