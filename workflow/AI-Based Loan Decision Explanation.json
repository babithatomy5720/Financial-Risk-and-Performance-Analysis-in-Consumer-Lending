    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.body;  // get webhook input\nconst loanId = webhookData.id;\n\nconst items = $input.all(); // all sheet rows\n\n// find matching loan\nconst row = items.find(item => String(item.json.id) === String(loanId));\n\nif (!row) {\n  throw new Error(`No match found for id: ${loanId}`);\n}\n\nreturn [\n  {\n    json: {\n      id: loanId,\n      question: webhookData.question,   // ✅ from webhook\n      grade: row.json.grade,\n      interest_rate: row.json.interest_rate,\n      dti: row.json.dti,\n      income_cat: row.json.income_cat,\n      emp_length_int: row.json.emp_length_int\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
