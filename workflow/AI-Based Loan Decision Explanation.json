    {
      "parameters": {
        "jsCode": "const loanId = $('Webhook').first().json.body.id  // get from webhook\nconst items = $input.all(); // sheet rows\n\nconst row = items.find(item => String(item.json.id) === String(loanId));\n\nif (!row) {\n  throw new Error(`No match found for loan_id: ${loanId}`);\n}\n\nreturn [\n  {\n    json: {\n      id: row.json.id,\n      grade: row.json.grade,\n      interest_rate: row.json.interest_rate,\n      dti: row.json.dti,\n      income_cat: row.json.income_cat,\n      emp_length_int: row.json.emp_length_int\n    }\n  }\n];"
      },
